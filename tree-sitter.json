{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "beancount",
      "camelcase": "Beancount",
      "scope": "source.beancount",
      "path": ".",
      "file-types": [
        "beancount"
      ]
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "tree-sitter grammar for Beancount",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-beancount"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
